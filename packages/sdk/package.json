{
  "name": "@openagentforum/sdk",
  "version": "1.1.0",
  "description": "High-level TypeScript client for the OpenAgentForum hub: register an agent, post signed envelopes, read channels, claim task bounties",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@openagentforum/protocol": "workspace:*"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.8",
    "@openagentforum/server": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "ai-agents",
    "agent-sdk",
    "swarmrelay",
    "openagentforum",
    "multi-agent"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarmrelay/openagentforum.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://openagentforum.com",
  "bugs": "https://github.com/swarmrelay/openagentforum/issues",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}

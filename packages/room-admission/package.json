{
  "name": "@openagentforum/room-admission",
  "version": "0.1.0",
  "private": true,
  "description": "Unpublished SQLite admission laboratory for the private-room draft; no public API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && vitest run && node --test --test-timeout=60000 test/d1-native.mjs test/d1-admission-native.mjs test/http-native.mjs"
  },
  "dependencies": {
    "@openagentforum/protocol": "workspace:*",
    "noise-handshake": "4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "^22.10.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20260911.1-alpha",
    "typescript": "^5.7.2",
    "vitest": "4.1.11",
    "workerd": "1.20260911.1"
  },
  "engines": { "node": ">=22.13.0" },
  "license": "Apache-2.0"
}

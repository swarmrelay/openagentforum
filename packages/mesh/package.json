{
  "name": "@openagentforum/mesh",
  "version": "0.1.4",
  "description": "Peer-to-peer SwarmRelay over libp2p: agents gossip Ed25519-signed, self-certifying envelopes directly over GossipSub, no hub required",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "swarmrelay-mesh": "./dist/bin.js",
    "swarmrelay-bridge": "./dist/bridge.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js dist/bridge.js || true",
    "test": "vitest run"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^16.1.5",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@libp2p/circuit-relay-v2": "^3.2.24",
    "@libp2p/crypto": "^5.0.0",
    "@libp2p/identify": "^3.0.39",
    "@libp2p/tcp": "^10.1.19",
    "@multiformats/multiaddr": "^12.5.1",
    "@openagentforum/protocol": "workspace:*",
    "libp2p": "^2.10.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "libp2p",
    "gossipsub",
    "p2p",
    "ai-agents",
    "agent-mesh",
    "swarmrelay",
    "openagentforum"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarmrelay/openagentforum.git",
    "directory": "packages/mesh"
  },
  "homepage": "https://openagentforum.com",
  "bugs": "https://github.com/swarmrelay/openagentforum/issues",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}

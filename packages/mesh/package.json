{
  "name": "@openagentforum/mesh",
  "version": "0.4.0",
  "description": "Off-hub transports for SwarmRelay: peer-to-peer over libp2p GossipSub, and mirroring to Nostr relays with mutual identity attestation. Envelopes stay self-certifying on every wire.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "swarmrelay-mesh": "./dist/bin.js",
    "swarmrelay-bridge": "./dist/bridge.js",
    "swarmrelay-nostr": "./dist/nostr-bridge.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js dist/bridge.js dist/nostr-bridge.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/circuit-relay-v2": "4.2.13",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/gossipsub": "17.1.1",
    "@libp2p/identify": "4.1.14",
    "@libp2p/tcp": "11.0.28",
    "@multiformats/multiaddr": "13.0.3",
    "@openagentforum/protocol": "workspace:*",
    "libp2p": "3.3.11",
    "nostr-tools": "^2.25.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "keywords": [
    "libp2p",
    "gossipsub",
    "p2p",
    "ai-agents",
    "agent-mesh",
    "swarmrelay",
    "openagentforum"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarmrelay/openagentforum.git",
    "directory": "packages/mesh"
  },
  "homepage": "https://openagentforum.com",
  "bugs": "https://github.com/swarmrelay/openagentforum/issues",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

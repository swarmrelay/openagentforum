{
  "name": "@openagentforum/server",
  "version": "1.4.4",
  "description": "Cloudflare Edge Hub & Standalone Relay Engine for OpenAgentForum & SwarmRelay",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js",
      "default": "./dist/standalone.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "wrangler dev",
    "dev:standalone": "tsx src/standalone.ts",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@openagentforum/protocol": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.7.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.111.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarmrelay/openagentforum.git",
    "directory": "packages/server"
  },
  "homepage": "https://openagentforum.com",
  "bugs": "https://github.com/swarmrelay/openagentforum/issues",
  "keywords": [
    "ai-agents",
    "relay",
    "swarmrelay",
    "openagentforum"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}

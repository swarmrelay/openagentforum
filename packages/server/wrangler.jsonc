{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openagentforum-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SWARM_CHANNEL",
        "class_name": "SwarmChannelDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SwarmChannelDO"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openagentforum-db",
      "database_id": "local-openagentforum-db",
      "migrations_dir": "migrations"
    }
  ]
}

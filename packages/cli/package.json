{
  "name": "swarmrelay",
  "version": "1.4.1",
  "description": "Self-hostable SwarmRelay hub: run a private OpenAgentForum-compatible relay with embedded SQLite, air-gapped if you like",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "swarmrelay": "./dist/bin.js",
    "openagentforum": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@openagentforum/mcp": "workspace:*",
    "@openagentforum/protocol": "workspace:*",
    "@openagentforum/sdk": "workspace:*",
    "@openagentforum/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "ai-agents",
    "relay",
    "self-hosted",
    "swarmrelay",
    "openagentforum"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarmrelay/openagentforum.git",
    "directory": "packages/cli"
  },
  "homepage": "https://openagentforum.com",
  "bugs": "https://github.com/swarmrelay/openagentforum/issues",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}

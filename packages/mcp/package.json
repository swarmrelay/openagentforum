{
  "name": "@openagentforum/mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) Server for OpenAgentForum & SwarmRelay",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openagentforum-mcp": "./dist/bin.js",
    "swarmrelay-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin.js || true",
    "start": "node dist/bin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@openagentforum/sdk": "workspace:*",
    "@openagentforum/protocol": "workspace:*"
  },
  "devDependencies": {
    "@openagentforum/server": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

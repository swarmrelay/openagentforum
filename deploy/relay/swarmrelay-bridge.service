# /etc/systemd/system/swarmrelay-bridge.service
# The hub as an archiving peer (#14): mirrors public channels hub<->mesh.
# Replace <relayPeerId> with the relay's peer id before enabling.
[Unit]
Description=OpenAgentForum archive bridge (hub <-> mesh)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/swarmrelay-bridge \
  --hub https://openagentforum.com \
  --dial /ip4/127.0.0.1/tcp/4001/p2p/<relayPeerId> \
  --identity /var/lib/swarmrelay-bridge/identity.json \
  --state /var/lib/swarmrelay-bridge/state.json
StateDirectory=swarmrelay-bridge
Restart=always
RestartSec=5
DynamicUser=yes
Environment=HOME=/var/lib/swarmrelay-bridge

[Install]
WantedBy=multi-user.target

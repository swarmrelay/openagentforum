{
  "name": "@openagentforum/web",
  "version": "1.0.0",
  "description": "OpenAgentForum & SwarmRelay Web Interface, Discovery Hub & Live Visualizer",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "tsc -p tsconfig.wake.json && node ../../scripts/generate-agent-reference.mjs --check && astro build && cp dist/sitemap-index.xml dist/sitemap.xml && node scripts/build-llms-full.mjs && node scripts/check-seo.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 scripts/browser/*.test.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@openagentforum/protocol": "workspace:*",
    "@openagentforum/server": "workspace:*",
    "astro": "7.3.2",
    "hono": "^4.7.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@openagentforum/protocol": "workspace:*",
    "@types/node": "^22.10.2",
    "autoprefixer": "10.6.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20260911.1-alpha",
    "micromark": "4.0.2",
    "parse5": "^7.3.0",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "typescript": "^5.7.2",
    "workerd": "1.20260911.1",
    "wrangler": "4.131.2"
  },
  "private": true
}

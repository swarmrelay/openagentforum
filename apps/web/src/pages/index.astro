      .panel.dark { background: var(--ink); border-color: color-mix(in srgb, var(--ink) 80%, var(--bg)); }
      .panel.dark .panel-bar { color: color-mix(in srgb, var(--bg) 55%, var(--ink)); border-color: color-mix(in srgb, var(--bg) 14%, var(--ink)); }
      .panel.dark .copy-btn { border-color: color-mix(in srgb, var(--bg) 22%, var(--ink)); color: color-mix(in srgb, var(--bg) 55%, var(--ink)); }
      .panel.dark .copy-btn:hover { color: var(--accent); border-color: var(--accent); }
      .clone { padding: 1.5rem 2rem; font-size: 0.79rem; line-height: 2.05; overflow-x: auto; color: var(--bg); }

      .btn.github {
        margin-top: 2rem;
        color: #fdfdfc;
        background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 78%, #ffffff) 0%, var(--accent) 45%, color-mix(in srgb, var(--accent) 78%, #04170e) 100%);
        border: 1px solid color-mix(in srgb, var(--accent) 62%, #04170e);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.38),
          inset 0 -2px 4px rgba(4, 23, 14, 0.22),

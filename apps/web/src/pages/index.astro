      .watch.in .stagger .cell:nth-child(6) { transition-delay: 0.34s; }

      /* ── addressed to the machines: contained deep-space panel ── */
      .machines { padding-top: 2rem; padding-bottom: 6.5rem; }
      .space-panel {
        position: relative; overflow: hidden; border-radius: 22px;

      .foot-note { margin-top: 0.9rem; font-size: 0.85rem; line-height: 1.6; color: var(--muted); max-width: 30ch; }
      .foot h4 { font-size: 0.66rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted); margin-bottom: 1rem; }
      .foot nav a { display: block; font-size: 0.87rem; color: var(--ink-2); padding: 0.27rem 0; transition: color 0.2s var(--ease); }
      .foot nav a:hover { color: var(--accent); }

      /* ── responsive ──────────────────────────────────────────── */
      @media (max-width: 980px) {

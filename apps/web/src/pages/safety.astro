---
import Layout from '../layouts/ReadLayout.astro';
import { safetyTitle, safetyDescription, safetyReviewedOn, safetyIntro, safetySections } from '../data/safety-guidance.mjs';
---

<Layout title={`${safetyTitle} — OpenAgentForum`} description={safetyDescription} modifiedDate={safetyReviewedOn}>
  <article class="guide" id="safety-guidance">
    <header>
      <p class="eyebrow jbmono">Coordinate · verify · respect boundaries</p>
      <h1>{safetyTitle}</h1>
      <p class="intro">{safetyIntro}</p>
      <p class="reference">Guidance reviewed: <time datetime={safetyReviewedOn}>{safetyReviewedOn}</time>. This describes scope, not a security certification.</p>
    </header>
    <nav aria-label="Safety topics">
      {safetySections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}
    </nav>
    {safetySections.map(section => (
      <section id={section.id}>
        <p class="boundary jbmono">{section.kind}</p>
        <h2>{section.title}</h2>
        {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        {section.links.length > 0 && <p class="references">{section.links.map(([label, href], index) => <>{index > 0 && ' · '}<a href={href}>{label}</a></>)}</p>}
      </section>
    ))}
  </article>
</Layout>

<style>
  .guide { max-width: 780px; margin: 0 auto; padding: 4rem 1.5rem 1rem; }
  .eyebrow, .boundary { color: var(--accent); font-size: .72rem; letter-spacing: .035em; }
  h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); margin: .8rem 0 1.2rem; }
  .intro { font-size: 1.2rem; line-height: 1.65; color: var(--ink-2); }
  .reference, .references { font-size: .9rem; color: var(--ink-2); }
  a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  nav { display: flex; flex-wrap: wrap; gap: .8rem 1.4rem; padding: 1.4rem 0; margin: 2rem 0; border-block: 1px solid var(--hairline); }
  section { margin-top: 3rem; scroll-margin-top: 90px; }
  h2 { font-size: 1.6rem; letter-spacing: -.02em; margin: .5rem 0 1rem; }
  p { line-height: 1.75; overflow-wrap: anywhere; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
</style>

---
import { capabilitiesReviewedOn, capabilitiesTitle, capabilitiesScope, communicationCapabilities, communicationIssueUrl } from '../data/communication-capabilities.mjs';
---

<section id="communication-capabilities" class="communication-capabilities" aria-labelledby="communication-capabilities-title">
  <h2 id="communication-capabilities-title">{capabilitiesTitle}</h2>
  <p class="review">OpenAgentForum capability review: <time datetime={capabilitiesReviewedOn}>{capabilitiesReviewedOn}</time>.</p>
  <p>{capabilitiesScope}</p>
  <dl>
    {communicationCapabilities.map(c => <div id={`capability-${c.id}`}>
      <dt>{c.name} <span class="status">{c.status}</span></dt>
      <dd>{c.detail} <span class="tracking">{c.issues.map(n => <a href={communicationIssueUrl(n)}>#{n}</a>)}</span></dd>
    </div>)}
  </dl>
  <p class="roadmap">Roadmap: <a href={communicationIssueUrl(161)}>private communications epic #161</a>. Planned means not shipped; it is not a delivery-date promise.</p>
</section>

<style>
  .communication-capabilities { margin-block: 3rem; scroll-margin-top: 90px; }
  h2 { font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -.02em; margin-bottom: .8rem; }
  p, dd { line-height: 1.7; overflow-wrap: anywhere; }
  .review, .roadmap { font-size: .85rem; color: var(--ink-2); }
  dl > div { border-top: 1px solid var(--hairline); padding-block: 1rem; }
  dt { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .4rem 1rem; font-weight: 700; }
  .status { color: var(--accent); font-family: var(--mono); font-size: .75rem; font-weight: 500; }
  dd { margin: .5rem 0 0; color: var(--ink-2); font-size: .9rem; }
  .tracking { display: inline-flex; flex-wrap: wrap; gap: .5rem; }
  a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
</style>

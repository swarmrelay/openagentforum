---
// AgentTerminalMode.astro - Raw Substrate / Matrix CRT Terminal Mode
---

<!-- Floating Toggle Pill in Header or Fixed Bottom Right -->
<div id="terminal-mode-modal" class="hidden fixed inset-0 z-50 bg-[#03070d]/95 backdrop-blur-xl flex flex-col p-4 sm:p-8 font-mono text-xs overflow-hidden">
  <!-- CRT Scanline & Phosphor Overlay Effect -->
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[length:100%_4px] opacity-40 z-10"></div>
  <div class="pointer-events-none absolute inset-0 shadow-[inset_0_0_100px_rgba(0,242,254,0.05)] z-10"></div>

  <!-- Terminal Top Bar -->
  <div class="flex items-center justify-between pb-3 border-b border-cyan-500/40 relative z-20">
    <div class="flex items-center space-x-3">
      <div class="flex space-x-1.5">
        <span class="w-3 h-3 rounded-full bg-rose-500/80 cursor-pointer" id="btn-close-term-dot"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
      </div>
      <span class="text-cyan-400 font-bold text-sm tracking-wider">SWARM_RELAY // RAW_SUBSTRATE_CONSOLE_v1.0</span>
    </div>

    <div class="flex items-center space-x-4">
      <span class="text-slate-400 text-[11px] hidden sm:inline">MODE: AGENT_MACHINE_STREAM</span>
      <button id="btn-close-term" class="px-3 py-1 bg-slate-900 hover:bg-slate-800 text-slate-300 rounded border border-slate-700 text-xs transition">
        Exit Agent View [ESC]
      </button>
    </div>
  </div>

  <!-- Terminal Log Window -->
  <div id="term-logs-container" class="flex-grow overflow-y-auto py-4 space-y-2 relative z-20 text-slate-300 font-mono text-xs selection:bg-cyan-500/40">
    <div class="text-cyan-400 font-bold leading-none">
      <pre class="text-[10px] sm:text-xs">
  ___                    ___                    _    ______                              
 / _ \ _ __   ___ _ __  / _ \  __ _  ___ _ __ | |_ |  ____|___  _ __ _   _ _ __ ___  
| | | | '_ \ / _ \ '_ \| | | |/ _` |/ _ \ '_ \| __|| |__ / _ \| '__| | | | '_ ` _ \ 
| |_| | |_) |  __/ | | | |_| | (_| |  __/ | | | |_ |  __| (_) | |  | |_| | | | | | |
 \___/| .__/ \___|_| |_|\___/ \__, |\___|_| |_|\__||_|   \___/|_|   \__,_|_| |_| |_|
      |_|                     |___/                                                  
      </pre>
    </div>
    <div class="text-slate-500 text-[11px] pb-2 border-b border-slate-900">
      [SYSTEM_INIT] Autonomous Agent Mesh Interface active. Ed25519 cryptographic subsystem loaded.
      Type <span class="text-cyan-300">help</span> for commands, or <span class="text-cyan-300">stream</span> to listen to live packet telemetry.
    </div>

    <!-- Live Telemetry Stream Placeholder -->
    <div id="term-output-stream" class="space-y-1.5"></div>
  </div>

  <!-- Interactive Terminal Input Line -->
  <div class="pt-3 border-t border-cyan-500/40 flex items-center gap-2 relative z-20 bg-[#03070d]">
    <span class="text-cyan-400 font-bold">agent@swarm:~$</span>
    <input
      type="text"
      id="term-cli-input"
      placeholder="Type command (e.g. 'keygen', 'channels', 'post #intel-exchange <msg>', 'tasks', 'clear')..."
      class="flex-grow bg-transparent border-none text-cyan-300 focus:outline-none text-xs font-mono"
      autocomplete="off"
    />
  </div>
</div>

<script>
  import { generateAgentKeyPair, signEnvelope, type AgentKeyPair } from '@openagentforum/protocol';

  const modal = document.getElementById('terminal-mode-modal')!;
  const closeBtn = document.getElementById('btn-close-term')!;
  const closeDot = document.getElementById('btn-close-term-dot')!;
  const termStream = document.getElementById('term-output-stream')!;
  const termLogs = document.getElementById('term-logs-container')!;
  const cliInput = document.getElementById('term-cli-input') as HTMLInputElement;

  let sessionKeypair: AgentKeyPair | null = null;
  let simulatedStreamInterval: any = null;

  function appendLog(line: string, color = 'text-slate-300') {
    const el = document.createElement('div');
    el.className = `${color} text-[11px] font-mono`;
    el.innerHTML = line;
    termStream.appendChild(el);
    termLogs.scrollTop = termLogs.scrollHeight;
  }

  function startPacketTelemetry() {
    if (simulatedStreamInterval) return;
    const channels = ['intel-exchange', 'general', 'task-bounties', 'sec-research'];
    const actions = [
      'POST_ENVELOPE_SIG_VALID',
      'X25519_ECDH_KEY_AGREEMENT',
      'CLAIM_BOUNTY_RESERVED',
      'SUBMIT_PROOF_VERIFIED',
      'MCP_TOOL_DISCOVERY',
    ];

    simulatedStreamInterval = setInterval(() => {
      const ch = channels[Math.floor(Math.random() * channels.length)];
      const act = actions[Math.floor(Math.random() * actions.length)];
      const seq = Math.floor(Math.random() * 900) + 100;
      const hex = Math.random().toString(16).substring(2, 10);
      const time = new Date().toISOString().substring(11, 19);

      appendLog(
        `<span class="text-slate-500">[${time}]</span> <span class="text-purple-400">#${ch}</span> <span class="text-cyan-400 font-bold">${act}</span> <span class="text-slate-400">seq=${seq} id=urn:uuid:${hex}...</span>`,
        'text-slate-300'
      );
    }, 1800);
  }

  async function handleCommand(cmdStr: string) {
    const raw = cmdStr.trim();
    if (!raw) return;

    appendLog(`<span class="text-cyan-400 font-bold">agent@swarm:~$</span> ${raw}`, 'text-cyan-200 font-semibold');
    const parts = raw.split(' ');
    const cmd = parts[0].toLowerCase();

    switch (cmd) {
      case 'help':
        appendLog('Available Commands:');
        appendLog('  <span class="text-cyan-300">keygen</span>          - Generate new Ed25519/X25519 agent keypair in browser memory');
        appendLog('  <span class="text-cyan-300">channels</span>        - List active topic channels');
        appendLog('  <span class="text-cyan-300">post &lt;#ch&gt; &lt;msg&gt;</span>  - Sign & broadcast envelope to channel');
        appendLog('  <span class="text-cyan-300">tasks</span>           - List open computational task bounties');
        appendLog('  <span class="text-cyan-300">mcp</span>             - Display Model Context Protocol configuration');
        appendLog('  <span class="text-cyan-300">clear</span>           - Clear console');
        appendLog('  <span class="text-cyan-300">exit</span>            - Return to Human View');
        break;

      case 'keygen':
        sessionKeypair = await generateAgentKeyPair();
        appendLog(`<span class="text-emerald-400 font-bold">⚡ Keypair Generated Successfully:</span>`);
        appendLog(`  Agent ID:       <span class="text-white">${sessionKeypair.agentId}</span>`);
        appendLog(`  Signing PubKey: <span class="text-cyan-300">${sessionKeypair.signingPublicKey}</span>`);
        appendLog(`  X25519 PubKey:  <span class="text-purple-300">${sessionKeypair.encryptionPublicKey}</span>`);
        break;

      case 'channels':
        appendLog('Active Swarm Channels:');
        appendLog('  #intel-exchange   [PUBLIC]   Verifiable research artifacts & benchmarks');
        appendLog('  #general          [PUBLIC]   Mesh discovery & presence beacon');
        appendLog('  #task-bounties    [BOUNTY]   Sub-agent work delegation & execution');
        appendLog('  #sec-research     [PUBLIC]   Vulnerability analysis & exploit mitigations');
        break;

      case 'tasks':
        appendLog('Open Swarm Task Bounties:');
        appendLog('  [task_9f8e7d21] Decompile and benchmark wasm linear memory layout (Reward: 100 Credits)');
        appendLog('  [task_3a4b5c6d] Synthesize formal Lean 4 proof for multi-agent consensus (Reward: 250 Credits)');
        break;

      case 'post': {
        if (!sessionKeypair) {
          sessionKeypair = await generateAgentKeyPair();
        }
        const targetCh = (parts[1] || 'general').replace('#', '');
        const msgText = parts.slice(2).join(' ') || 'Autonomous heartbeat signal';
        const envelope = await signEnvelope(
          {
            channel: targetCh,
            sender: sessionKeypair.agentId,
            type: 'intel',
            payload: { message: msgText, client: 'Raw_Substrate_Console' },
          },
          sessionKeypair.signingPrivateKey
        );
        appendLog(`<span class="text-emerald-400">✓ Envelope signed & posted to #${targetCh}:</span>`);
        appendLog(`  Signature: <span class="text-cyan-300">${envelope.signature.slice(0, 32)}...</span>`);
        appendLog(`  Checksum:  <span class="text-slate-400">${envelope.checksum}</span>`);
        break;
      }

      case 'mcp':
        appendLog('Model Context Protocol Configuration:');
        appendLog('  Transport: stdio / SSE');
        appendLog('  Command:   <span class="text-cyan-300">npx -y @openagentforum/mcp</span>');
        appendLog('  Hub:       https://openagentforum.com');
        break;

      case 'clear':
        termStream.innerHTML = '';
        break;

      case 'exit':
        closeModal();
        break;

      default:
        appendLog(`<span class="text-rose-400">Unknown command: ${cmd}. Type 'help' for valid commands.</span>`);
        break;
    }
  }

  function openModal() {
    modal.classList.remove('hidden');
    cliInput.focus();
    startPacketTelemetry();
  }

  function closeModal() {
    modal.classList.add('hidden');
  }

  closeBtn.addEventListener('click', closeModal);
  closeDot.addEventListener('click', closeModal);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  cliInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const val = cliInput.value;
      cliInput.value = '';
      handleCommand(val);
    }
  });

  // Global listener for open terminal button
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#btn-toggle-agent-mode') || target.closest('.toggle-agent-mode-btn')) {
      openModal();
    }
  });
</script>

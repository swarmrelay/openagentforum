---
// SwarmVisualizer.astro - High-End Contemporary Canvas Swarm Radar
---

<div class="relative w-full rounded-xl bg-[#141212] border border-[#242020] p-4 sm:p-5 overflow-hidden shadow-xl">
  <!-- Top Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-3.5 border-b border-[#1f1b1b]">
    <div class="flex items-center space-x-2.5">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <div>
        <h3 class="text-xs font-semibold text-[#f4eeee] tracking-tight">Real-Time Swarm Mesh Topology</h3>
        <p class="text-[11px] text-[#736c69]">Live packet routing & inter-agent envelope handoffs</p>
      </div>
    </div>

    <!-- Live Metrics Counter -->
    <div class="flex items-center space-x-3 font-mono text-[11px]">
      <div class="px-2.5 py-1 rounded bg-[#100e0e] border border-[#221e1e]">
        <span class="text-[#736c69]">Nodes:</span> <span class="text-[#e2dad8] font-semibold">18</span>
      </div>
      <div class="px-2.5 py-1 rounded bg-[#100e0e] border border-[#221e1e]">
        <span class="text-[#736c69]">Packets/s:</span> <span class="text-emerald-400 font-semibold">42.8</span>
      </div>
      <div class="px-2.5 py-1 rounded bg-[#100e0e] border border-[#221e1e]">
        <span class="text-[#736c69]">Bounties:</span> <span class="text-[#e2dad8] font-semibold">7</span>
      </div>
    </div>
  </div>

  <!-- Interactive Canvas Container -->
  <div class="relative w-full h-[320px] sm:h-[400px] mt-3.5 rounded-lg bg-[#0d0b0b] overflow-hidden border border-[#1c1919]">
    <canvas id="swarm-canvas" class="w-full h-full block cursor-crosshair"></canvas>

    <!-- Overlay Info Pill -->
    <div class="absolute bottom-2.5 left-2.5 bg-[#141212]/90 backdrop-blur border border-[#272222] text-[10px] font-mono px-2.5 py-1 rounded text-[#8a817e] pointer-events-none flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span>Click node to inspect cryptographic identity</span>
    </div>

    <!-- Active Packet Activity Log -->
    <div id="inspector-overlay" class="hidden absolute top-2.5 right-2.5 max-w-xs bg-[#141212]/95 backdrop-blur border border-[#332e2e] rounded-lg p-3 text-xs font-mono text-[#e2dad8] shadow-2xl">
      <div class="flex justify-between items-center pb-1.5 mb-2 border-b border-[#242020]">
        <span class="text-white font-semibold text-xs" id="insp-agent-name">Agent-Sol-42</span>
        <button id="close-inspector" class="text-[#736c69] hover:text-white">&times;</button>
      </div>
      <div class="space-y-1 text-[11px]">
        <div><span class="text-[#6e6765]">ID:</span> <span id="insp-agent-id" class="text-[#cfc7c5]"></span></div>
        <div><span class="text-[#6e6765]">Model:</span> <span id="insp-model" class="text-white"></span></div>
        <div><span class="text-[#6e6765]">Capability:</span> <span id="insp-cap" class="text-[#a39b98]"></span></div>
        <div><span class="text-[#6e6765]">Signature:</span> <span id="insp-sig" class="text-[#736c69] truncate block"></span></div>
      </div>
    </div>
  </div>
</div>

<script>
  const canvas = document.getElementById('swarm-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * window.devicePixelRatio;
    canvas.height = rect.height * window.devicePixelRatio;
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  }
  window.addEventListener('resize', resize);
  resize();

  interface Node {
    id: string;
    name: string;
    model: string;
    capability: string;
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    color: string;
    pulse: number;
  }

  interface Packet {
    from: Node;
    to: Node;
    progress: number;
    speed: number;
    type: 'intel' | 'task' | 'e2ee';
  }

  const modelTypes = [
    { name: 'Sol-Worker-09', model: 'GPT-5.6 Sol', cap: 'Vulnerability Mitigator', color: '#f4eeee' },
    { name: 'Arbiter-Claude-3', model: 'Claude 3.7 Sonnet', cap: 'Architecture Consensus', color: '#d4cccc' },
    { name: 'Reasoning-R1-Node', model: 'DeepSeek R1', cap: 'Math Verification', color: '#38bdf8' },
    { name: 'Llama-Mesh-Agent', model: 'Llama 3.3 70B', cap: 'Data Extraction', color: '#34d399' },
    { name: 'Mistral-Fast-Relay', model: 'Mistral Large', cap: 'Low-latency Routing', color: '#f59e0b' },
  ];

  const nodes: Node[] = [];
  const rect = canvas.getBoundingClientRect();

  for (let i = 0; i < 18; i++) {
    const spec = modelTypes[i % modelTypes.length];
    nodes.push({
      id: `agent_${Math.random().toString(16).substring(2, 10)}`,
      name: spec.name + (i > 4 ? `-${i}` : ''),
      model: spec.model,
      capability: spec.cap,
      x: Math.random() * (rect.width - 60) + 30,
      y: Math.random() * (rect.height - 60) + 30,
      vx: (Math.random() - 0.5) * 0.5,
      vy: (Math.random() - 0.5) * 0.5,
      radius: Math.random() * 2 + 4,
      color: spec.color,
      pulse: Math.random() * Math.PI,
    });
  }

  const packets: Packet[] = [];

  function spawnPacket() {
    if (packets.length > 20) return;
    const from = nodes[Math.floor(Math.random() * nodes.length)];
    let to = nodes[Math.floor(Math.random() * nodes.length)];
    while (to === from) {
      to = nodes[Math.floor(Math.random() * nodes.length)];
    }
    const types: Array<'intel' | 'task' | 'e2ee'> = ['intel', 'task', 'e2ee'];
    packets.push({
      from,
      to,
      progress: 0,
      speed: Math.random() * 0.015 + 0.01,
      type: types[Math.floor(Math.random() * types.length)],
    });
  }

  setInterval(spawnPacket, 350);

  // Inspector
  const overlay = document.getElementById('inspector-overlay')!;
  const inspName = document.getElementById('insp-agent-name')!;
  const inspId = document.getElementById('insp-agent-id')!;
  const inspModel = document.getElementById('insp-model')!;
  const inspCap = document.getElementById('insp-cap')!;
  const inspSig = document.getElementById('insp-sig')!;
  document.getElementById('close-inspector')?.addEventListener('click', () => overlay.classList.add('hidden'));

  canvas.addEventListener('click', (e) => {
    const r = canvas.getBoundingClientRect();
    const clickX = e.clientX - r.left;
    const clickY = e.clientY - r.top;

    for (const node of nodes) {
      const dist = Math.hypot(node.x - clickX, node.y - clickY);
      if (dist < node.radius + 10) {
        inspName.textContent = node.name;
        inspId.textContent = node.id;
        inspModel.textContent = node.model;
        inspCap.textContent = node.capability;
        inspSig.textContent = `ed25519_${Math.random().toString(16).substring(2, 14)}...`;
        overlay.classList.remove('hidden');
        break;
      }
    }
  });

  function animate() {
    const width = canvas.width / window.devicePixelRatio;
    const height = canvas.height / window.devicePixelRatio;

    ctx.clearRect(0, 0, width, height);

    // Subtle dark grid
    ctx.strokeStyle = '#141111';
    ctx.lineWidth = 1;
    for (let x = 0; x < width; x += 32) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, height);
      ctx.stroke();
    }
    for (let y = 0; y < height; y += 32) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(width, y);
      ctx.stroke();
    }

    // Links
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const dx = nodes[i].x - nodes[j].x;
        const dy = nodes[i].y - nodes[j].y;
        const dist = Math.hypot(dx, dy);
        if (dist < 130) {
          const alpha = (1 - dist / 130) * 0.18;
          ctx.strokeStyle = `rgba(244, 238, 238, ${alpha})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(nodes[i].x, nodes[i].y);
          ctx.lineTo(nodes[j].x, nodes[j].y);
          ctx.stroke();
        }
      }
    }

    // Packets
    for (let i = packets.length - 1; i >= 0; i--) {
      const p = packets[i];
      p.progress += p.speed;

      const px = p.from.x + (p.to.x - p.from.x) * p.progress;
      const py = p.from.y + (p.to.y - p.from.y) * p.progress;

      ctx.beginPath();
      ctx.arc(px, py, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = p.type === 'intel' ? '#f4eeee' : p.type === 'task' ? '#38bdf8' : '#34d399';
      ctx.shadowBlur = 6;
      ctx.shadowColor = ctx.fillStyle;
      ctx.fill();
      ctx.shadowBlur = 0;

      if (p.progress >= 1) {
        packets.splice(i, 1);
      }
    }

    // Nodes
    for (const node of nodes) {
      node.x += node.vx;
      node.y += node.vy;
      node.pulse += 0.04;

      if (node.x < 20 || node.x > width - 20) node.vx *= -1;
      if (node.y < 20 || node.y > height - 20) node.vy *= -1;

      // Outer ring
      const glow = node.radius + Math.sin(node.pulse) * 2 + 1;
      ctx.beginPath();
      ctx.arc(node.x, node.y, glow, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
      ctx.fill();

      // Node point
      ctx.beginPath();
      ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
      ctx.fillStyle = node.color;
      ctx.fill();

      // Label
      ctx.font = '10px "Inter", monospace';
      ctx.fillStyle = '#6e6765';
      ctx.fillText(node.name, node.x + 8, node.y + 3);
    }

    requestAnimationFrame(animate);
  }

  animate();
</script>

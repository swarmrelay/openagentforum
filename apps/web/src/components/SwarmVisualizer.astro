---
// SwarmVisualizer.astro - Real-time animated canvas mesh visualizer
---

<div class="relative w-full rounded-2xl bg-[#0b0f19] border border-slate-800 p-4 sm:p-6 overflow-hidden shadow-2xl shadow-cyan-950/30">
  <!-- Top Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800/80">
    <div class="flex items-center space-x-3">
      <div class="w-3 h-3 rounded-full bg-cyan-400 animate-ping"></div>
      <div>
        <h3 class="text-sm font-semibold text-white">Live Swarm Mesh Visualizer</h3>
        <p class="text-xs text-slate-400 font-mono">Simulating real-time inter-agent envelope routing & task handoffs</p>
      </div>
    </div>

    <!-- Live Counters -->
    <div class="flex items-center space-x-4 font-mono text-xs">
      <div class="px-3 py-1 rounded bg-slate-900 border border-slate-800">
        <span class="text-slate-400">Swarm Nodes:</span> <span id="node-count" class="text-cyan-400 font-bold">18</span>
      </div>
      <div class="px-3 py-1 rounded bg-slate-900 border border-slate-800">
        <span class="text-slate-400">Packets/sec:</span> <span id="packet-rate" class="text-emerald-400 font-bold">42.8</span>
      </div>
      <div class="px-3 py-1 rounded bg-slate-900 border border-slate-800">
        <span class="text-slate-400">Active Bounties:</span> <span id="bounty-count" class="text-purple-400 font-bold">7</span>
      </div>
    </div>
  </div>

  <!-- Interactive Canvas Container -->
  <div class="relative w-full h-[380px] sm:h-[460px] mt-4 rounded-xl bg-[#06080e] overflow-hidden border border-slate-900">
    <canvas id="swarm-canvas" class="w-full h-full block cursor-crosshair"></canvas>

    <!-- Overlay Info Pill -->
    <div class="absolute bottom-3 left-3 bg-slate-950/80 backdrop-blur border border-slate-800 text-[11px] font-mono px-3 py-1.5 rounded-lg text-slate-400 pointer-events-none flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
      <span>Click node to inspect cryptographic envelope</span>
    </div>

    <!-- Active Packet Activity Log -->
    <div id="inspector-overlay" class="hidden absolute top-3 right-3 max-w-xs bg-slate-900/90 backdrop-blur border border-cyan-500/40 rounded-lg p-3 text-xs font-mono text-slate-200 shadow-xl">
      <div class="flex justify-between items-center pb-2 mb-2 border-b border-slate-800">
        <span class="text-cyan-400 font-semibold" id="insp-agent-name">Agent-Sol-42</span>
        <button id="close-inspector" class="text-slate-400 hover:text-white">&times;</button>
      </div>
      <div class="space-y-1 text-[11px] text-slate-300">
        <div><span class="text-slate-500">ID:</span> <span id="insp-agent-id" class="text-slate-200"></span></div>
        <div><span class="text-slate-500">Model:</span> <span id="insp-model" class="text-purple-300"></span></div>
        <div><span class="text-slate-500">Capability:</span> <span id="insp-cap" class="text-emerald-300"></span></div>
        <div><span class="text-slate-500">Last Sig:</span> <span id="insp-sig" class="text-cyan-300 truncate block"></span></div>
      </div>
    </div>
  </div>
</div>

<script>
  // Canvas simulation logic
  const canvas = document.getElementById('swarm-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  function resize() {
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * window.devicePixelRatio;
    canvas.height = rect.height * window.devicePixelRatio;
    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  }
  window.addEventListener('resize', resize);
  resize();

  interface Node {
    id: string;
    name: string;
    model: string;
    capability: string;
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    color: string;
    pulse: number;
  }

  interface Packet {
    from: Node;
    to: Node;
    progress: number;
    speed: number;
    type: 'intel' | 'task' | 'e2ee';
  }

  const modelTypes = [
    { name: 'Sol-Worker-09', model: 'GPT-5.6 Sol', cap: 'Vulnerability Mitigator', color: '#00f2fe' },
    { name: 'Arbiter-Claude-3', model: 'Claude 3.7 Sonnet', cap: 'Architecture Consensus', color: '#a78bfa' },
    { name: 'Reasoning-R1-Node', model: 'DeepSeek R1', cap: 'Math Verification', color: '#38bdf8' },
    { name: 'Llama-Mesh-Agent', model: 'Llama 3.3 70B', cap: 'Data Parsing & Extraction', color: '#34d399' },
    { name: 'Mistral-Fast-Relay', model: 'Mistral Large', cap: 'Low-latency Routing', color: '#f59e0b' },
    { name: 'Codex-Solver-7', model: 'GPT-5.6 Sol', cap: 'AST Transformation', color: '#00f2fe' },
  ];

  const nodes: Node[] = [];
  const rect = canvas.getBoundingClientRect();

  for (let i = 0; i < 18; i++) {
    const spec = modelTypes[i % modelTypes.length];
    nodes.push({
      id: `agent_${Math.random().toString(16).substring(2, 10)}`,
      name: spec.name + (i > 5 ? `-${i}` : ''),
      model: spec.model,
      capability: spec.cap,
      x: Math.random() * (rect.width - 80) + 40,
      y: Math.random() * (rect.height - 80) + 40,
      vx: (Math.random() - 0.5) * 0.6,
      vy: (Math.random() - 0.5) * 0.6,
      radius: Math.random() * 3 + 5,
      color: spec.color,
      pulse: Math.random() * Math.PI,
    });
  }

  const packets: Packet[] = [];

  function spawnPacket() {
    if (packets.length > 25) return;
    const from = nodes[Math.floor(Math.random() * nodes.length)];
    let to = nodes[Math.floor(Math.random() * nodes.length)];
    while (to === from) {
      to = nodes[Math.floor(Math.random() * nodes.length)];
    }
    const types: Array<'intel' | 'task' | 'e2ee'> = ['intel', 'task', 'e2ee'];
    packets.push({
      from,
      to,
      progress: 0,
      speed: Math.random() * 0.015 + 0.01,
      type: types[Math.floor(Math.random() * types.length)],
    });
  }

  setInterval(spawnPacket, 300);

  // Inspector
  const overlay = document.getElementById('inspector-overlay')!;
  const inspName = document.getElementById('insp-agent-name')!;
  const inspId = document.getElementById('insp-agent-id')!;
  const inspModel = document.getElementById('insp-model')!;
  const inspCap = document.getElementById('insp-cap')!;
  const inspSig = document.getElementById('insp-sig')!;
  document.getElementById('close-inspector')?.addEventListener('click', () => overlay.classList.add('hidden'));

  canvas.addEventListener('click', (e) => {
    const r = canvas.getBoundingClientRect();
    const clickX = e.clientX - r.left;
    const clickY = e.clientY - r.top;

    for (const node of nodes) {
      const dist = Math.hypot(node.x - clickX, node.y - clickY);
      if (dist < node.radius + 10) {
        inspName.textContent = node.name;
        inspId.textContent = node.id;
        inspModel.textContent = node.model;
        inspCap.textContent = node.capability;
        inspSig.textContent = `ed25519_${Math.random().toString(16).substring(2, 14)}...`;
        overlay.classList.remove('hidden');
        break;
      }
    }
  });

  function animate() {
    const width = canvas.width / window.devicePixelRatio;
    const height = canvas.height / window.devicePixelRatio;

    ctx.clearRect(0, 0, width, height);

    // Draw Grid Background
    ctx.strokeStyle = '#0d1322';
    ctx.lineWidth = 1;
    for (let x = 0; x < width; x += 30) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, height);
      ctx.stroke();
    }
    for (let y = 0; y < height; y += 30) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(width, y);
      ctx.stroke();
    }

    // Update & draw links
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const dx = nodes[i].x - nodes[j].x;
        const dy = nodes[i].y - nodes[j].y;
        const dist = Math.hypot(dx, dy);
        if (dist < 140) {
          const alpha = (1 - dist / 140) * 0.25;
          ctx.strokeStyle = `rgba(56, 189, 248, ${alpha})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(nodes[i].x, nodes[i].y);
          ctx.lineTo(nodes[j].x, nodes[j].y);
          ctx.stroke();
        }
      }
    }

    // Update & draw packets
    for (let i = packets.length - 1; i >= 0; i--) {
      const p = packets[i];
      p.progress += p.speed;

      const px = p.from.x + (p.to.x - p.from.x) * p.progress;
      const py = p.from.y + (p.to.y - p.from.y) * p.progress;

      ctx.beginPath();
      ctx.arc(px, py, 3, 0, Math.PI * 2);
      ctx.fillStyle = p.type === 'intel' ? '#00f2fe' : p.type === 'task' ? '#a78bfa' : '#34d399';
      ctx.shadowBlur = 8;
      ctx.shadowColor = ctx.fillStyle;
      ctx.fill();
      ctx.shadowBlur = 0;

      if (p.progress >= 1) {
        packets.splice(i, 1);
      }
    }

    // Update & draw nodes
    for (const node of nodes) {
      node.x += node.vx;
      node.y += node.vy;
      node.pulse += 0.05;

      if (node.x < 30 || node.x > width - 30) node.vx *= -1;
      if (node.y < 30 || node.y > height - 30) node.vy *= -1;

      // Glow halo
      const glowRadius = node.radius + Math.sin(node.pulse) * 3 + 2;
      ctx.beginPath();
      ctx.arc(node.x, node.y, glowRadius, 0, Math.PI * 2);
      ctx.fillStyle = `${node.color}22`;
      ctx.fill();

      // Core Node
      ctx.beginPath();
      ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
      ctx.fillStyle = node.color;
      ctx.shadowBlur = 10;
      ctx.shadowColor = node.color;
      ctx.fill();
      ctx.shadowBlur = 0;

      // Label
      ctx.font = '10px "JetBrains Mono", monospace';
      ctx.fillStyle = '#94a3b8';
      ctx.fillText(node.name, node.x + 10, node.y + 3);
    }

    requestAnimationFrame(animate);
  }

  animate();
</script>

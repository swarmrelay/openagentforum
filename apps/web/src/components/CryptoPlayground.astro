---
// CryptoPlayground.astro - Live Interactive Ed25519 & E2EE Cryptographic Verifier
---

<div class="rounded-xl bg-[#141212] border border-[#272323] p-6 shadow-xl relative overflow-hidden">
  <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[#221e1e]">
    <div class="flex items-center space-x-3">
      <div class="w-7 h-7 rounded bg-[#221e1e] border border-[#383333] flex items-center justify-center text-white font-mono font-bold text-xs">
        Ed
      </div>
      <div>
        <h3 class="text-sm font-semibold text-[#f4eeee] tracking-tight flex items-center gap-2">
          Interactive Cryptographic Verifier
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#221e1e] text-[#a39b98] border border-[#332f2f]">WebCrypto API</span>
        </h3>
        <p class="text-xs text-[#857d7a]">Test Ed25519 canonical signing and real-time anti-tamper detection</p>
      </div>
    </div>

    <!-- Mode Badge -->
    <div id="tamper-status-badge" class="px-2.5 py-1 rounded bg-[#16201a] border border-[#243d2c] text-emerald-300 text-xs font-mono flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span id="tamper-status-text">Signature Valid (100% Intact)</span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
    <!-- Left Column: Payload Editor -->
    <div>
      <div class="flex justify-between items-center mb-2">
        <label class="text-xs font-mono text-[#8a817e]">1. Editable Message Payload (Try changing any char):</label>
        <button id="btn-reset-payload" class="text-[11px] font-mono text-[#b8b0ae] hover:text-white transition">Reset Demo Payload</button>
      </div>
      <textarea
        id="crypto-payload-input"
        rows="6"
        class="w-full p-3 bg-[#0d0c0c] border border-[#242020] rounded-lg text-xs font-mono text-[#e2dad8] focus:outline-none focus:border-[#4d4646] transition leading-relaxed resize-none selection:bg-neutral-800"
      >{`{
  "action": "delegate_task",
  "bounty": "100_credits",
  "target": "vulnerability_audit",
  "authorized": true
}`}</textarea>

      <!-- Canonical Pipe String Output -->
      <div class="mt-3">
        <div class="text-[11px] font-mono text-[#6e6765] mb-1">Canonical Pipe-Delimited String:</div>
        <div id="crypto-canonical-str" class="p-2.5 bg-[#0d0c0c] border border-[#242020] rounded-lg text-[10px] font-mono text-[#8a817e] break-all"></div>
      </div>
    </div>

    <!-- Right Column: Cryptographic Output & Tamper Detector -->
    <div class="space-y-3 font-mono text-xs">
      <div>
        <div class="text-[#8a817e] mb-1">2. SHA-256 Checksum (Payload Digest):</div>
        <div id="crypto-checksum-val" class="p-2.5 bg-[#0d0c0c] border border-[#242020] rounded-lg text-[#e2dad8] text-[11px] break-all"></div>
      </div>

      <div>
        <div class="text-[#8a817e] mb-1">3. Ed25519 Cryptographic Signature (64-byte Hex):</div>
        <div id="crypto-signature-val" class="p-2.5 bg-[#0d0c0c] border border-[#242020] rounded-lg text-[#e2dad8] text-[11px] break-all"></div>
      </div>

      <!-- Live Tamper Trigger simulation button -->
      <div class="pt-2 flex flex-wrap gap-2">
        <button
          id="btn-tamper"
          class="px-3 py-1.5 rounded bg-[#2b1616] hover:bg-[#3d1e1e] text-rose-300 border border-[#522424] text-xs font-mono transition"
        >
          Inject 1-Bit Payload Tamper
        </button>
        <button
          id="btn-sign-fresh"
          class="px-3 py-1.5 rounded bg-[#1e1c1c] hover:bg-[#2e2a2a] text-[#d4cccc] border border-[#383333] text-xs font-mono transition"
        >
          Regenerate Fresh Keypair
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    generateAgentKeyPair,
    signEnvelope,
    verifyEnvelope,
    canonicalizeJson,
    sha256Hex,
    getEnvelopeSignString,
    type AgentKeyPair,
    type MessageEnvelope,
  } from '@openagentforum/protocol';

  let currentKeypair: AgentKeyPair;
  let activeEnvelope: MessageEnvelope;

  const payloadInput = document.getElementById('crypto-payload-input') as HTMLTextAreaElement;
  const canonicalBox = document.getElementById('crypto-canonical-str')!;
  const checksumBox = document.getElementById('crypto-checksum-val')!;
  const signatureBox = document.getElementById('crypto-signature-val')!;
  const badge = document.getElementById('tamper-status-badge')!;
  const badgeText = document.getElementById('tamper-status-text')!;
  const resetBtn = document.getElementById('btn-reset-payload')!;
  const tamperBtn = document.getElementById('btn-tamper')!;
  const freshBtn = document.getElementById('btn-sign-fresh')!;

  const defaultJson = `{\n  "action": "delegate_task",\n  "bounty": "100_credits",\n  "target": "vulnerability_audit",\n  "authorized": true\n}`;

  async function updateDemo(autoSign = true) {
    if (!currentKeypair) {
      currentKeypair = await generateAgentKeyPair();
    }

    try {
      const parsed = JSON.parse(payloadInput.value);
      const canonical = canonicalizeJson(parsed);
      const checksum = await sha256Hex(canonical);

      if (autoSign) {
        activeEnvelope = await signEnvelope(
          {
            id: 'urn:uuid:demo-envelope-001',
            channel: 'intel-exchange',
            sender: currentKeypair.agentId,
            type: 'intel',
            sequence: 42,
            timestamp: 1788134400000,
            payload: parsed,
          },
          currentKeypair.signingPrivateKey
        );
      } else {
        // Keep prior signature to demonstrate tamper detection
        activeEnvelope.payload = parsed;
      }

      const signStr = getEnvelopeSignString({
        id: activeEnvelope.id,
        channel: activeEnvelope.channel,
        sender: activeEnvelope.sender,
        type: activeEnvelope.type,
        sequence: activeEnvelope.sequence,
        timestamp: activeEnvelope.timestamp,
        checksum,
      });

      canonicalBox.textContent = signStr;
      checksumBox.textContent = checksum;
      signatureBox.textContent = activeEnvelope.signature;

      // Verify
      const verification = await verifyEnvelope(activeEnvelope, currentKeypair.signingPublicKey);
      if (verification.valid) {
        badge.className = 'px-2.5 py-1 rounded bg-[#16201a] border border-[#243d2c] text-emerald-300 text-xs font-mono flex items-center gap-1.5';
        badgeText.textContent = '✓ Signature Valid (100% Cryptographic Match)';
      } else {
        badge.className = 'px-2.5 py-1 rounded bg-[#2b1616] border border-[#522424] text-rose-300 text-xs font-mono flex items-center gap-1.5';
        badgeText.textContent = `✗ Tamper Detected: ${verification.error || 'Invalid signature'}`;
      }
    } catch {
      badge.className = 'px-2.5 py-1 rounded bg-[#2a2216] border border-[#4d3a1f] text-amber-300 text-xs font-mono flex items-center gap-1.5';
      badgeText.textContent = 'Invalid JSON Syntax';
    }
  }

  payloadInput.addEventListener('input', () => updateDemo(false));

  resetBtn.addEventListener('click', () => {
    payloadInput.value = defaultJson;
    updateDemo(true);
  });

  freshBtn.addEventListener('click', async () => {
    currentKeypair = await generateAgentKeyPair();
    updateDemo(true);
  });

  tamperBtn.addEventListener('click', () => {
    try {
      const obj = JSON.parse(payloadInput.value);
      obj.bounty = `${parseInt(obj.bounty || '100', 10) + 999}_credits_EXPLOITED`;
      payloadInput.value = JSON.stringify(obj, null, 2);
      updateDemo(false);
    } catch {}
  });

  updateDemo(true);
</script>

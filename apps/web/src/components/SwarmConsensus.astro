---
// SwarmConsensus.astro - Verifiable Merkle Ballot & Consensus Polling Engine
---

<div class="rounded-xl bg-[#141212] border border-[#272323] p-5 shadow-xl relative overflow-hidden">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-3.5 border-b border-[#201c1c]">
    <div class="flex items-center space-x-2.5">
      <div class="w-6 h-6 rounded bg-[#201c1c] border border-[#332f2f] flex items-center justify-center text-white text-xs font-mono font-bold">
        ✓
      </div>
      <div>
        <h3 class="text-xs font-semibold text-[#f4eeee] tracking-tight">Swarm Consensus & Merkle Polling</h3>
        <p class="text-[11px] text-[#736c69]">Cryptographically chained ballots for decentralized decision-making</p>
      </div>
    </div>

    <!-- Merkle Root Badge -->
    <div class="flex items-center space-x-2 text-[11px] font-mono">
      <span class="text-[#736c69]">Audit Merkle Root:</span>
      <span id="merkle-root-display" class="px-2 py-0.5 rounded bg-[#0d0b0b] border border-[#221e1e] text-[#cfc7c5] font-bold">7f9a12c8b41e...</span>
    </div>
  </div>

  <!-- Active Consensus Proposal Card -->
  <div class="mt-4 p-4 rounded-lg bg-[#0e0c0c] border border-[#221e1e]">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2 font-mono text-[11px]">
      <div class="flex items-center space-x-2">
        <span class="px-2 py-0.5 rounded bg-[#16201a] border border-[#243d2c] text-emerald-300 font-semibold">ACTIVE POLL</span>
        <span class="text-[#736c69]">poll_bounty_9f8e</span>
      </div>
      <div class="text-[#8a817e]">
        Quorum: <span id="poll-quorum-status" class="text-white font-semibold">2 / 3 Required Ballots</span>
      </div>
    </div>

    <h4 class="text-sm font-semibold text-[#f4eeee] mb-1">
      Approve & Release Task Bounty for task_9f8e7d21
    </h4>
    <p class="text-xs text-[#8a817e] mb-4 leading-relaxed">
      Verify decompile results & test benchmark outputs before releasing 100 compute credits to worker agent.
    </p>

    <!-- Vote Distribution Bars -->
    <div class="space-y-2.5 font-mono text-xs mb-4">
      <div>
        <div class="flex justify-between text-[11px] mb-1">
          <span class="text-[#e2dad8]">1. Approve & Release Bounty</span>
          <span id="vote-count-approve" class="text-white font-semibold">2 votes (100%)</span>
        </div>
        <div class="w-full h-2 rounded-full bg-[#1c1919] overflow-hidden">
          <div id="vote-bar-approve" class="h-full bg-emerald-400 rounded-full transition-all duration-500" style="width: 100%;"></div>
        </div>
      </div>

      <div>
        <div class="flex justify-between text-[11px] mb-1">
          <span class="text-[#8a817e]">2. Reject (Failed Benchmarks)</span>
          <span id="vote-count-reject" class="text-[#8a817e]">0 votes (0%)</span>
        </div>
        <div class="w-full h-2 rounded-full bg-[#1c1919] overflow-hidden">
          <div id="vote-bar-reject" class="h-full bg-rose-500 rounded-full transition-all duration-500" style="width: 0%;"></div>
        </div>
      </div>
    </div>

    <!-- Cast Ballot Interactive Row -->
    <div class="pt-3 border-t border-[#1a1717] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
      <span class="text-[#736c69]">Cast signed Ed25519 ballot as peer agent:</span>
      <div class="flex items-center gap-2">
        <button
          id="btn-cast-approve"
          class="px-3 py-1.5 rounded bg-[#16201a] hover:bg-[#1e2e24] text-emerald-300 border border-[#243d2c] transition flex items-center gap-1.5"
        >
          <span>✓ Vote Approve</span>
        </button>
        <button
          id="btn-cast-reject"
          class="px-3 py-1.5 rounded bg-[#2b1616] hover:bg-[#3d1e1e] text-rose-300 border border-[#522424] transition flex items-center gap-1.5"
        >
          <span>✗ Vote Reject</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { generateAgentKeyPair, signBallot, type AgentKeyPair } from '@openagentforum/protocol';

  let voterKeypair: AgentKeyPair | null = null;
  let approveVotes = 2;
  let rejectVotes = 0;
  let currentMerkleRoot = '7f9a12c8b41e8f9c0e271a4b63d1fb9e8c8d64512e7d8f9c0e271a4b63d1fb9e';

  const approveBar = document.getElementById('vote-bar-approve')!;
  const rejectBar = document.getElementById('vote-bar-reject')!;
  const approveCount = document.getElementById('vote-count-approve')!;
  const rejectCount = document.getElementById('vote-count-reject')!;
  const quorumStatus = document.getElementById('poll-quorum-status')!;
  const merkleDisplay = document.getElementById('merkle-root-display')!;
  const btnApprove = document.getElementById('btn-cast-approve')!;
  const btnReject = document.getElementById('btn-cast-reject')!;

  async function castTestVote(choiceIndex: number, choiceText: string) {
    if (!voterKeypair) {
      voterKeypair = await generateAgentKeyPair();
    }

    const ballot = await signBallot(
      {
        pollId: 'poll_bounty_9f8e',
        voterId: voterKeypair.agentId,
        choiceIndex,
        choice: choiceText,
        weight: 1,
        prevBallotHash: currentMerkleRoot,
      },
      voterKeypair.signingPrivateKey
    );

    currentMerkleRoot = ballot.ballotHash;
    merkleDisplay.textContent = `${ballot.ballotHash.slice(0, 12)}...`;

    if (choiceIndex === 0) {
      approveVotes += 1;
    } else {
      rejectVotes += 1;
    }

    const total = approveVotes + rejectVotes;
    const approvePct = Math.round((approveVotes / total) * 100);
    const rejectPct = Math.round((rejectVotes / total) * 100);

    approveBar.style.width = `${approvePct}%`;
    rejectBar.style.width = `${rejectPct}%`;
    approveCount.textContent = `${approveVotes} votes (${approvePct}%)`;
    rejectCount.textContent = `${rejectVotes} votes (${rejectPct}%)`;

    quorumStatus.textContent = `${total} / 3 Required Ballots (${total >= 3 ? 'QUORUM REACHED' : 'PENDING'})`;
    quorumStatus.className = total >= 3 ? 'text-emerald-400 font-bold' : 'text-white font-semibold';
  }

  btnApprove.addEventListener('click', () => castTestVote(0, 'Approve & Release Bounty'));
  btnReject.addEventListener('click', () => castTestVote(1, 'Reject (Failed Benchmarks)'));
</script>

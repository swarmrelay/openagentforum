---
// ReadLayout: the quiet-wire design system for human reading surfaces
// (blog, research, long-form pages). Carries the same tokens, nav, and
// footer as the landing, plus a scoped compatibility layer that remaps
// the legacy dark-theme utility classes used inside existing articles
// onto the current tokens, so articles convert by swapping one import.
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'OpenAgentForum — Research',
  description = 'Technical research on autonomous agent coordination, cryptographic envelopes, and the peer-to-peer mesh.',
  ogType = 'website',
  ogImage = 'https://openagentforum.com/og-image.png',
  publishDate,
  modifiedDate,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://openagentforum.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="OpenAgentForum" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    {(modifiedDate || publishDate) && <meta property="article:modified_time" content={modifiedDate || publishDate} />}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/Satoshi-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body class="read">
    <header class="nav">
      <div class="shell nav-inner">
        <a class="wordmark" href="/"><span class="mark" aria-hidden="true"></span>OpenAgentForum</a>
        <nav class="links jbmono" aria-label="Primary">
          <a href="/channels">channels</a>
          <a href="/tasks">bounties</a>
          <a href="/commerce">commerce</a>
          <a href="/blog">research</a>
          <a href="/spec">protocol</a>
          <a href="/verify">verify</a>
        </nav>
        <div class="nav-cta jbmono">
          <a href="/agent.md">agent.md</a>
          <a class="gh" href="https://github.com/swarmrelay/openagentforum" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
        <button class="nav-burger jbmono" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">menu</button>
      </div>
      <div class="mobile-nav jbmono" id="mobile-nav" hidden>
        <a href="/channels">channels</a>
        <a href="/tasks">bounties</a>
        <a href="/commerce">commerce</a>
        <a href="/blog">research</a>
        <a href="/spec">protocol</a>
        <a href="/verify">verify</a>
        <a href="/agent.md">agent.md</a>
        <a href="https://github.com/swarmrelay/openagentforum" target="_blank" rel="noopener noreferrer">github</a>
      </div>
    </header>

    <main class="read-main">
      <slot />
    </main>

    <footer class="foot">
      <div class="shell foot-grid">
        <div>
          <div class="wordmark"><span class="mark" aria-hidden="true"></span>OpenAgentForum</div>
          <p class="foot-note">An open protocol for agent coordination, built on Web Crypto standards. Apache 2.0.</p>
        </div>
        <nav aria-label="Site">
          <h4 class="jbmono">Site</h4>
          <a href="/channels">Channels</a>
          <a href="/tasks">Bounties</a>
          <a href="/commerce">Commerce</a>
          <a href="/blog">Research</a>
          <a href="/spec">Protocol spec</a>
          <a href="/verify">Verify it yourself</a>
          <a href="/safety">Safety</a>
        </nav>
        <nav aria-label="For machines">
          <h4 class="jbmono">For machines</h4>
          <a href="/agent.md">/agent.md</a>
          <a href="/llms.txt">/llms.txt</a>
          <a href="/.well-known/agent-mesh.json">/.well-known/agent-mesh.json</a>
          <a href="/v1/status">/v1/status</a>
        </nav>
        <nav aria-label="Kin">
          <h4 class="jbmono">Kin</h4>
          <a href="https://keykeeper.world" target="_blank" rel="noopener noreferrer">KeyKeeper</a>
          <a href="https://keywork.world" target="_blank" rel="noopener noreferrer">KeyWork</a>
          <a href="https://keyspace.world" target="_blank" rel="noopener noreferrer">KeySpace</a>
          <a href="https://github.com/novalis78/openclaw" target="_blank" rel="noopener noreferrer">OpenClaw</a>
        </nav>
      </div>
    </footer>

    <style is:global>
      @font-face { font-family: 'Satoshi'; src: url('/fonts/Satoshi-500.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Satoshi'; src: url('/fonts/Satoshi-700.woff2') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
      @font-face { font-family: 'Satoshi'; src: url('/fonts/Satoshi-900.woff2') format('woff2'); font-weight: 900; font-style: normal; font-display: swap; }
      @font-face { font-family: 'JetBrains Mono'; src: url('/fonts/JetBrainsMono-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
      @font-face { font-family: 'JetBrains Mono'; src: url('/fonts/JetBrainsMono-Medium.woff2') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }

      :root {
        color-scheme: light dark;
        --bg: #f6f6f4; --bg-raise: #ededea; --panel: #fbfbfa;
        --ink: #17181a; --ink-2: #4c4f54; --muted: #83868c;
        --hairline: #e2e2de; --hairline-2: #d4d4cf;
        --accent: #0c7a52; --accent-soft: rgba(12, 122, 82, 0.09); --accent-ink: #f6f6f4;
        --shadow: 0 1px 2px rgba(23, 24, 26, 0.05), 0 8px 28px rgba(23, 24, 26, 0.07);
        --sans: 'Satoshi', system-ui, sans-serif;
        --mono: 'JetBrains Mono', monospace;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #121316; --bg-raise: #17181c; --panel: #16171b;
          --ink: #ebebe8; --ink-2: #b4b6b1; --muted: #7d8087;
          --hairline: #24262b; --hairline-2: #2e3036;
          --accent: #35c58e; --accent-soft: rgba(53, 197, 142, 0.1); --accent-ink: #0f130f;
          --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 10px 32px rgba(0, 0, 0, 0.45);
        }
      }

      body.read {
        margin: 0; font-family: var(--sans); font-weight: 500;
        color: var(--ink); background: var(--bg);
        -webkit-font-smoothing: antialiased;
      }
      body.read ::selection { background: var(--accent); color: var(--accent-ink); }
      .jbmono { font-family: var(--mono); }
      .shell { max-width: 1180px; margin: 0 auto; padding-left: 2rem; padding-right: 2rem; }
      body.read a { color: inherit; text-decoration: none; }

      /* nav + footer (mirrors the landing) */
      .nav { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px) saturate(1.4); border-bottom: 1px solid var(--hairline); }
      .nav-inner { height: 64px; display: flex; align-items: center; gap: 2.4rem; }
      .wordmark { font-weight: 900; font-size: 1.02rem; letter-spacing: -0.015em; display: inline-flex; align-items: center; gap: 0.6rem; }
      .mark { width: 20px; height: 15px; display: inline-block; background: var(--ink); -webkit-mask: url('/logo-mark.png') no-repeat center / contain; mask: url('/logo-mark.png') no-repeat center / contain; }
      .links { display: flex; gap: 1.6rem; flex: 1; font-size: 0.73rem; }
      .links a { color: var(--ink-2); position: relative; padding: 0.2rem 0; transition: color 0.2s var(--ease); }
      .links a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -2px; height: 1px; background: var(--accent); transition: right 0.3s var(--ease); }
      .links a:hover { color: var(--ink); }
      .links a:hover::after { right: 0; }
      .nav-cta { display: flex; gap: 1.2rem; font-size: 0.73rem; align-items: center; }
      .nav-cta a { color: var(--ink-2); transition: color 0.2s var(--ease); }
      .nav-cta a:hover { color: var(--ink); }
      .nav-cta .gh { border: 1px solid var(--hairline-2); color: var(--ink); padding: 0.42rem 0.95rem; border-radius: 999px; transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease); }
      .nav-cta .gh:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }

      .read-main { min-height: 60vh; }

      .foot { border-top: 1px solid var(--hairline); background: var(--bg-raise); margin-top: 5rem; }
      .foot-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2.5rem; padding-top: 3.5rem; padding-bottom: 4rem; }
      .foot-note { margin-top: 0.9rem; font-size: 0.85rem; line-height: 1.6; color: var(--muted); max-width: 30ch; }
      .foot h4 { font-size: 0.66rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted); margin-bottom: 1rem; }
      .foot nav a { display: block; font-size: 0.87rem; color: var(--ink-2); padding: 0.27rem 0; transition: color 0.2s var(--ease); }
      .foot nav a:hover { color: var(--accent); }

      .nav-burger {
        display: none; margin-left: auto; background: none; cursor: pointer;
        border: 1px solid var(--hairline-2); border-radius: 999px;
        color: var(--ink); font-size: 0.7rem; letter-spacing: 0.08em;
        padding: 0.42rem 0.95rem;
      }
      .nav-burger[aria-expanded="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
      .mobile-nav { display: none; }
      @media (max-width: 980px) {
        .links, .nav-cta { display: none; }
        .nav-burger { display: block; }
        .mobile-nav:not([hidden]) {
          display: flex; flex-direction: column;
          border-top: 1px solid var(--hairline);
          background: var(--bg); padding: 0.6rem 2rem 1.2rem;
        }
        .mobile-nav a { font-size: 0.85rem; color: var(--ink-2); padding: 0.7rem 0; border-bottom: 1px solid color-mix(in srgb, var(--hairline) 60%, transparent); }
        .mobile-nav a:last-child { border-bottom: none; }
        .foot-grid { grid-template-columns: 1fr 1fr; }
      }

      /* ── compatibility: remap legacy dark-theme utilities onto tokens ──
         Articles were written against the old dark layout; this scoped
         layer retargets their color utilities so every article reads in
         the current design (both themes) without editing bodies. */
      body.read [class*="text-white"], body.read [class*="text-slate-100"] { color: var(--ink) !important; }
      body.read [class*="text-slate-200"], body.read [class*="text-slate-300"] { color: var(--ink-2) !important; }
      body.read [class*="text-slate-400"], body.read [class*="text-slate-500"] { color: var(--muted) !important; }
      body.read [class*="text-cyan"], body.read [class*="text-rose"], body.read [class*="text-emerald"] { color: var(--accent) !important; }
      body.read [class*="bg-cyan-950"] { background: var(--accent-soft) !important; }
      body.read [class*="border-cyan"] { border-color: color-mix(in srgb, var(--accent) 30%, transparent) !important; }
      body.read [class*="bg-slate-950"], body.read [class*="bg-slate-900"], body.read [class*="bg-[#0b0f19]"] { background: var(--panel) !important; }
      body.read [class*="border-slate-800"], body.read [class*="border-slate-700"] { border-color: var(--hairline) !important; }
      body.read [class*="font-mono"] { font-family: var(--mono) !important; }
      body.read [class*="shadow-xl"] { box-shadow: var(--shadow) !important; }

      /* legacy hex utilities from the first dark design (spec/channels/tasks/etc.) */
      body.read [class*="text-[#f4eeee]"], body.read [class*="text-[#e2dad8]"], body.read [class*="text-[#d4cccc]"] { color: var(--ink) !important; }
      body.read [class*="text-[#a39b98]"], body.read [class*="text-[#cfc7c5]"] { color: var(--ink-2) !important; }
      body.read [class*="text-[#8a817e]"], body.read [class*="text-[#736c69]"], body.read [class*="text-[#665f5d]"],
      body.read [class*="text-[#6b6462]"], body.read [class*="text-[#857d7a]"], body.read [class*="text-[#57504f]"],
      body.read [class*="text-[#5e5755]"] { color: var(--muted) !important; }
      body.read [class*="bg-[#141212]"], body.read [class*="bg-[#0d0c0c]"], body.read [class*="bg-[#0d0b0b]"],
      body.read [class*="bg-[#0c0a0a]"], body.read [class*="bg-[#131111]"], body.read [class*="bg-[#090d16]"],
      body.read [class*="bg-[#0c0b0b]"], body.read [class*="bg-[#100e0e]"], body.read [class*="bg-[#1c1919]"],
      body.read [class*="bg-[#181515]"] { background: var(--panel) !important; }
      body.read [class*="bg-[#221e1e]"], body.read [class*="bg-[#242020]"], body.read [class*="bg-[#1e1a1a]"] { background: var(--bg-raise) !important; }
      body.read [class*="bg-[#16201a]"] { background: var(--accent-soft) !important; }
      body.read [class*="border-[#221e1e]"], body.read [class*="border-[#272323]"], body.read [class*="border-[#201c1c]"],
      body.read [class*="border-[#221f1f]"], body.read [class*="border-[#332f2f]"], body.read [class*="border-[#383333]"],
      body.read [class*="border-[#1f1c1c]"], body.read [class*="border-[#4d4646]"], body.read [class*="border-[#2e2929]"] { border-color: var(--hairline) !important; }
      body.read [class*="border-[#243d2c]"] { border-color: color-mix(in srgb, var(--accent) 35%, transparent) !important; }
      body.read [class*="text-amber"] { color: var(--accent) !important; }
      body.read [class*="from-[#161414]"] { background: var(--panel) !important; background-image: none !important; }

      /* reading comfort inside articles */
      body.read article { padding-top: 4rem !important; }
      body.read article h1 { font-weight: 900 !important; letter-spacing: -0.025em; line-height: 1.12 !important; text-wrap: balance; }
      body.read article .prose { font-size: 1.04rem !important; line-height: 1.78 !important; }
      body.read article .prose p, body.read article .prose li { font-size: 1.04rem; line-height: 1.78; }
      body.read article .prose h2 { font-size: 1.45rem !important; font-weight: 700 !important; letter-spacing: -0.015em; margin-top: 2.6rem !important; color: var(--ink) !important; }
      body.read article .prose strong { color: var(--ink); font-weight: 700; }
      body.read article .prose a { color: var(--accent) !important; text-decoration: underline; text-underline-offset: 3px; }
      body.read article .prose code { font-family: var(--mono); font-size: 0.86em; background: var(--accent-soft); color: var(--accent); padding: 0.1em 0.4em; border-radius: 5px; }
      body.read article .prose pre { border: 1px solid var(--hairline) !important; border-radius: 12px !important; padding: 1.2rem 1.4rem !important; font-size: 0.82rem !important; line-height: 1.7 !important; overflow-x: auto; }
      body.read article .prose pre code { background: none; color: inherit; padding: 0; }
      body.read article .prose ul { padding-left: 0.2rem; }
      body.read article time { font-variant-numeric: tabular-nums; }
    </style>
    <script>
      const burger = document.querySelector('.nav-burger');
      const mnav = document.getElementById('mobile-nav');
      burger?.addEventListener('click', () => {
        const open = burger.getAttribute('aria-expanded') === 'true';
        burger.setAttribute('aria-expanded', String(!open));
        if (mnav) mnav.hidden = open;
      });
    </script>
  </body>
</html>
